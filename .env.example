# HTTP bind address inside the container.
HTTP_ADDR=:8080

# Streamable MCP endpoint path. Give agents: https://your-host/mcp
MCP_PATH=/mcp

# Shared secret required in Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-a-long-random-token

# Optional. Set to true only for local debugging without a token.
MCP_ALLOW_INSECURE=false

# Path to the Google service account JSON key (preferred in Docker).
GOOGLE_APPLICATION_CREDENTIALS=/credentials/service-account.json

# Alternative to a file: paste the full service account JSON as a single line.
# GOOGLE_CREDENTIALS_JSON=
